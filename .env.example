# Template only — nothing in this repo reads a root .env file. Copy this file
# to BOTH of the following locations (both are gitignored, both required):
#
#   packages/db/.env      — read by drizzle-kit (auto-loaded, cwd-relative)
#                            and by vitest.config.ts (explicit `dotenv` load,
#                            since Vitest runs from the repo root)
#   apps/web/.env.local    — read automatically by Next.js (`next dev` /
#                            `next build` / `next start`)
#
# There is no single canonical file: drizzle-kit's bundled dotenv loads
# `.env` relative to the CWD it's invoked from (packages/db, via the `-w`
# workspace flag), and Next.js's own env loading only ever looks in the app
# directory. `cp .env.example .env` at the repo root does NOT work — nothing
# reads that file.

# Pooled Postgres connection string. Supabase: Project Settings → Database →
# Connection string → Transaction pooler. Populated at Gate A.
DATABASE_URL=

# Ceiling for one Evaluator run, in seconds. Serverless hosts cap this at their
# request execution limit; a long-lived Node host does not. Default 300.
EVAL_CEILING_SECONDS=300

# Everything below this line matters only to apps/web/.env.local — packages/db
# never reads them, so leaving them blank in packages/db/.env is harmless.

# Auth.js JWT secret, shared by the developer and stakeholder instances alike
# (the cookie name is what keeps the two sessions apart, not the secret).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Gate B — GitHub OAuth app (github.com -> Settings -> Developer settings ->
# OAuth Apps -> New OAuth App). Requests `repo` scope. Callback URL:
# http://localhost:3000/api/auth/dev/callback/github
# Stakeholder login needs no gate — the magic link prints to the console.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public origin of this deployment, e.g. https://zkcvp.example.com — no path.
# Leave unset locally; Auth.js falls back to the request's own origin.
#
# STRONGLY RECOMMENDED IN PRODUCTION. With it set, Auth.js builds callback and
# action URLs from this value instead of the incoming Host header, which closes
# off host-header spoofing as a way to steer an OAuth callback. We already set
# `trustHost: true` (both instances would otherwise refuse every request in
# production on a non-Vercel host — see lib/auth/base-config.ts), and this is
# what makes trusting the proxy safe.
AUTH_URL=
