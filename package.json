{
  "name": "zkcvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @zkcvp/web",
    "build": "npm run build -w @zkcvp/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "tsx": "^4.23.1",
    "@types/node": "^26.1.2"
  }
}
